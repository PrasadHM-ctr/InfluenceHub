# ============================================================
# InfluenceHub backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set True in production to force HTTPS/HSTS/secure cookies.
DJANGO_SECURE=False

# --- PostgreSQL ---
# Either supply DATABASE_URL (standard on Render / Railway / Neon / Heroku):
DATABASE_URL=
# Or supply individual PostgreSQL connection params:
POSTGRES_DB=influencer_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS / CSRF (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# Public URL of the Django API (used to build absolute media URLs).
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# --- Redis (channels + cache) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Email verification ---
# Development default is the console backend: codes print in the terminal.
# Set USE_SES=true to deliver via Amazon SES (transactional only).
# For plain SMTP use EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend plus the SMTP_* vars.
USE_SES=False
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=InfluenceHub <no-reply@example.com>
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15

# --- Rate limiting ---
ANON_THROTTLE_RATE=60/min
USER_THROTTLE_RATE=600/min
AUTH_THROTTLE_RATE=20/min
UPLOAD_THROTTLE_RATE=120/min

# --- Upload limits (bytes) ---
CHAT_MAX_UPLOAD_BYTES=10485760
PROFILE_IMAGE_MAX_BYTES=5242880
CAMPAIGN_ATTACHMENT_MAX_BYTES=10485760
# Cost guard: max stored attachments in one conversation (0 disables).
CHAT_MAX_ATTACHMENTS_PER_CONVERSATION=200

# --- AWS S3 media storage ---
# When USE_S3=true all uploads go to S3; PostgreSQL stores only file references.
# The bucket must NOT be publicly writable — objects are written by the backend.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
# Optional custom domain for media URLs (your own domain; no CDN service used):
AWS_S3_CUSTOM_DOMAIN=
# Signed (expiring) media URLs keep the bucket private while letting the
# browser display images. Keep True.
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=3600

# --- Amazon SES (only used when USE_SES=true) ---
AWS_SES_REGION_NAME=ap-south-1
AWS_SES_FROM_EMAIL=

# --- Amazon Cognito authentication ---
# Created by infrastructure/terraform (outputs: cognito_user_pool_id /
# cognito_app_client_id). These are identifiers, NOT secrets.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=